<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="600"
             x:Class="TinaPASS.Main.ImportOverlay">

    <Border Background="#1A1A1A"
            CornerRadius="15"
            Padding="20"
            BorderBrush="#2D2D2D"
            BorderThickness="1"
            MaxHeight="620"
            Width="480">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="&#xE838;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="#EAB308"
                           VerticalAlignment="Center" />
                <TextBlock Text="Импорт паролей"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Условия импорта -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ConditionsText"
                           Foreground="#CCCCCC"
                           FontSize="12"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Text="Перед импортом ознакомьтесь с условиями:&#x0a;&#x0a;1. ГДЕ ДОСТУПЕН ИМПОРТ&#x0a;Импорт работает только в группе «Без группы». Если сейчас открыта другая группа, сначала переключитесь на «Без группы», иначе импорт будет отклонён.&#x0a;&#x0a;2. ФОРМАТЫ ФАЙЛОВ&#x0a;Поддерживаются текстовые файлы: .txt, .csv, .log, .pass, .md — а также любой другой текстовый файл.&#x0a;&#x0a;3. ФОРМАТ СТРОКИ&#x0a;Каждая строка — одна запись. Поля разделяются маркерами:&#x0a;&#x0a;Название PASSWORD пароль NAME логин EMAIL почта&#x0a;&#x0a;• Название — любые слова до первого маркера;&#x0a;• PASSWORD — сам пароль;&#x0a;• NAME — логин;&#x0a;• EMAIL — почта.&#x0a;&#x0a;4. ПРАВИЛА ОБРАБОТКИ&#x0a;• Регистр маркеров не важен (PASSWORD, password — одинаково);&#x0a;• Знак «=» перед маркером не нужен;&#x0a;• Пустые строки пропускаются;&#x0a;• Если пароль не найден, строка помечается как ошибка импорта;&#x0a;• Данные добавляются в группу «Без группы» и сохраняются в локальной базе.&#x0a;&#x0a;5. ПРИМЕР СТРОКИ&#x0a;Google PASSWORD qwerty123 NAME user@gmail.com EMAIL user@gmail.com&#x0a;&#x0a;Нажав «Продолжить», выберите файл на устройстве." />
            </ScrollViewer>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button x:Name="CancelBtn"
                        Content="Отмена"
                        Background="Transparent"
                        Foreground="#CCCCCC"
                        CornerRadius="10"
                        Padding="18,10"
                        Cursor="Hand"
                        Click="OnCancelClick">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#33FFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Style>
                    </Button.Styles>
                </Button>
                <Button x:Name="ContinueBtn"
                        Content="Продолжить"
                        Background="#EAB308"
                        Foreground="#1B1B22"
                        FontWeight="SemiBold"
                        CornerRadius="10"
                        Padding="18,10"
                        Cursor="Hand"
                        Click="OnContinueClick">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#FDE047" />
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="Background" Value="#CA9A06" />
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
