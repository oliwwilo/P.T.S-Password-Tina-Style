<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TinaPASS.Main.DrawerPanel">

    <UserControl.Styles>
        <!-- Кнопки-иконки: плавное появление белого выделения при наведении -->
        <Style Selector="Button.social">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.social /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background"
                                     Duration="0:0:0.3"
                                     Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.social:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.social:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Цвет иконки: чёрный по умолчанию, брендовый при наведении -->
        <Style Selector="Button.social Path">
            <Setter Property="Fill" Value="#000000" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill"
                                     Duration="0:0:0.2"
                                     Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.social.telegram:pointerover Path">
            <Setter Property="Fill" Value="#79D0FF" />
            <Setter Property="Effect" Value="drop-shadow(0 0 9 #3E93C4)" />
        </Style>
        <Style Selector="Button.social.youtube:pointerover Path">
            <Setter Property="Fill" Value="#FF4040" />
            <Setter Property="Effect" Value="drop-shadow(0 0 9 #C93A3A)" />
        </Style>
        <Style Selector="Button.social.boosty:pointerover Path">
            <Setter Property="Fill" Value="#E09C4C" />
            <Setter Property="Effect" Value="drop-shadow(0 0 9 #C9852E)" />
        </Style>

        <!-- Пункты меню: плавное выделение текста при наведении -->
        <Style Selector="Button.menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground"
                                     Duration="0:0:0.15"
                                     Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.menu.dim">
            <Setter Property="Foreground" Value="#9E9E9E" />
        </Style>
        <Style Selector="Button.menu:pointerover">
            <Setter Property="Foreground" Value="#D5F8F8" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" Margin="28,24,28,48" Spacing="6">

                <!-- АВАТАРКА -->
                <Border x:Name="AvatarBorder"
                        Width="64"
                        Height="64"
                        CornerRadius="40"
                        Background="{DynamicResource SurfaceBrush}"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        PointerPressed="OnAvatarClick">
                    <Grid>
                        <Image x:Name="AvatarImage"
                               Stretch="UniformToFill" />
                        <TextBlock x:Name="AvatarText"
                                   Text="👤"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White" />
                    </Grid>
                </Border>

                <!-- ПРОФИЛЬ (имя / email) -->
                <TextBlock x:Name="UserNameText"
                           Text="Не авторизован"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />

                <TextBlock x:Name="UserEmailText"
                           Text="Войдите в аккаунт"
                           FontSize="12"
                           Foreground="#9E9E9E"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />

                <!-- ПРОФИЛЬ -->
                <Button x:Name="LoginButton"
                        Classes="menu"
                        Content="Войти"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        Padding="18,4"
                        Margin="0,10,0,0"
                        Cursor="Hand"
                        Click="OnLoginClick" />

                <!-- НАСТРОЙКИ -->
                <Button x:Name="ThemeButton"
                        Classes="menu"
                        Content="Настройки"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        Padding="18,4"
                        Cursor="Hand"
                        Click="OnThemeClick" />

                <!-- ВЫЙТИ ИЗ АККАУНТА -->
                <Button x:Name="LogoutButton"
                        Classes="menu dim"
                        Content="Выйти из аккаунта"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Padding="18,4"
                        IsVisible="False"
                        Cursor="Hand"
                        Click="OnLogoutClick" />

                <!-- ЛИЦЕНЗИЯ И СОГЛАШЕНИЯ -->
                <Button x:Name="LicenceButton"
                        Classes="menu dim"
                        Content="Лицензия и соглашения"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Padding="18,4"
                        Cursor="Hand"
                        Click="OnLicenceClick" />

                <!-- ИКОНКИ: Telegram + Boosty в ряд -->
                <StackPanel x:Name="SocialRow"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="24"
                            Margin="0,14,0,0">

                    <!-- ТЕЛЕГРАМ -->
                    <Grid x:Name="TelegramRoot"
                          Width="34"
                          Height="34"
                          VerticalAlignment="Center">
                        <Button x:Name="TelegramButton"
                                Classes="social telegram"
                                Background="Transparent"
                                Padding="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Click="OnTelegramClick"
                                PointerEntered="OnTelegramEnter"
                                PointerExited="OnTelegramLeave">
                            <Grid Width="26" Height="26">
                                <Path Data="M446.7 98.6l-67.6 318.8c-5.1 22.5-18.4 28.1-37.3 17.5l-103-75.9-49.7 47.8c-5.5 5.5-10.1 10.1-20.7 10.1l7.4-104.9 190.9-172.5c8.3-7.4-1.8-11.5-12.9-4.1L117.8 284 16.2 252.2c-22.1-6.9-22.5-22.1 4.6-32.7L418.2 66.4c18.4-6.9 34.5 4.1 28.5 32.2z"
                                      Stretch="Uniform"
                                      Width="22"
                                      Height="22"
                                      Margin="-5,5,0,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Подсказка: появляется снизу, стрелка указывает вверх -->
                        <StackPanel x:Name="TelegramTooltip"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Width="100"
                                    Margin="0,32,0,0"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                </Transitions>
                            </StackPanel.Transitions>

                            <Path Data="M6,0 L12,7 L0,7 Z"
                                  Fill="#FFFFFF"
                                  Width="10"
                                  Height="7"
                                  HorizontalAlignment="Center" />
                            <Border Background="#FFFFFF"
                                    CornerRadius="8"
                                    Padding="22,7"
                                    BoxShadow="0 5 18 0 #80000000"
                                    HorizontalAlignment="Stretch">
                                <TextBlock Text="Телеграм"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="#1B1B22" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- YOUTUBE -->
                    <Grid x:Name="YouTubeRoot"
                          Width="34"
                          Height="34"
                          VerticalAlignment="Center">
                        <Button x:Name="YouTubeButton"
                                Classes="social youtube"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Padding="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Cursor="Hand"
                                Click="OnYouTubeClick"
                                PointerEntered="OnYouTubeEnter"
                                PointerExited="OnYouTubeLeave">
                            <Grid Width="26" Height="26">
                                <Path Data="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                                      Margin="0,7,0,0"
                                      Stretch="Uniform"
                                      Width="22"
                                      Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="YouTubeTooltip"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Width="104"
                                    Margin="0,32,0,0"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                </Transitions>
                            </StackPanel.Transitions>
                            <Path Data="M6,0 L12,7 L0,7 Z"
                                  Fill="#FFFFFF"
                                  Width="10"
                                  Height="7"
                                  HorizontalAlignment="Center" />
                            <Border Background="#FFFFFF"
                                    CornerRadius="8"
                                    Padding="22,7"
                                    BoxShadow="0 5 18 0 #80000000"
                                    HorizontalAlignment="Stretch">
                                <TextBlock Text="YouTube"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="#1B1B22" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- BOOSTY (донат) -->
                    <Grid x:Name="BoostyRoot"
                          Width="34"
                          Height="34"
                          VerticalAlignment="Center">
                        <Button x:Name="BoostyButton"
                                Classes="social boosty"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Padding="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Cursor="Hand"
                                Click="OnBoostyClick"
                                PointerEntered="OnBoostyEnter"
                                PointerExited="OnBoostyLeave">
                            <Grid Width="26" Height="26">
                                <Path Data="M2.661 14.337L6.801 0h6.362L11.88 4.444l-.038.077l-3.378 11.733h3.15q-1.982 4.934-3.086 7.733c-5.816-.063-7.442-4.228-6.02-9.155M8.554 24l7.67-11.035h-3.25l2.83-7.073c4.852.508 7.137 4.33 5.791 8.952C20.16 19.81 14.344 24 8.68 24h-.127z"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20"
                                      Margin="5,0,0,3"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="BoostyTooltip"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Width="96"
                                    Margin="0,32,0,0"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                </Transitions>
                            </StackPanel.Transitions>
                            <Path Data="M6,0 L12,7 L0,7 Z"
                                  Fill="#FFFFFF"
                                  Width="10"
                                  Height="7"
                                  HorizontalAlignment="Center" />
                            <Border Background="#FFFFFF"
                                    CornerRadius="8"
                                    Padding="22,7"
                                    BoxShadow="0 5 18 0 #80000000"
                                    HorizontalAlignment="Stretch">
                                <TextBlock Text="Boosty"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="#1B1B22" />
                            </Border>
                        </StackPanel>
                    </Grid>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- LSPK + версия в левом нижнем углу -->
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="28,0,0,16">
            <TextBlock x:Name="DrawerLspk"
                       Text="LSPK"
                       FontFamily="avares://TinaPASS/Assets/Fonts#Zalando Sans SemiExpanded"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#D5F8F8" />
            <TextBlock x:Name="DrawerVersion"
                       Text="ver 1.0"
                       FontFamily="Inter"
                       FontSize="12"
                       FontWeight="SemiBold"
                       LetterSpacing="1"
                       Foreground="#9E9E9E"
                       VerticalAlignment="Bottom" />
        </StackPanel>
    </Grid>
</UserControl>
