<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TinaPASS.Main.PassCardRed">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions" Value="{x:Null}" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="#2669DBFE" />
            <Setter Property="Foreground" Value="#A5F3FC" />
        </Style>
        <Style Selector="Button.icon:pressed">
            <Setter Property="Background" Value="#4069DBFE" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border Background="#80000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,33,0,0" />

        <Border Background="Transparent" Tapped="OnOverlayTapped" Margin="0,33,0,0" />

        <Border Background="{DynamicResource SurfaceLightBrush}"
                CornerRadius="20"
                Padding="25"
                Width="400"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Spacing="15">

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText"
                               Text="Новый пароль"
                               FontSize="20"
                               FontFamily="Inter"
                               FontWeight="ExtraBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Название -->
                <TextBlock Text="Название" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" />
                <TextBox x:Name="TitleBox"
                         Watermark="Введите название"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         CornerRadius="10"
                         Padding="15" />

                <!-- Email -->
                <TextBlock Text="Почта" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                    <TextBox x:Name="EmailBox"
                             Grid.Column="0"
                             Watermark="example@mail.com"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             CornerRadius="10"
                             Padding="15" />
                    <Button x:Name="CopyEmailButton"
                            Grid.Column="1"
                            Classes="icon"
                            Content="&#xE8C8;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Width="40"
                            Height="36"
                            Margin="8,0,0,0"
                            CornerRadius="8"
                            FontSize="16"
                            Click="OnCopyEmailClick"
                            ToolTip.Tip="Скопировать почту" />
                </Grid>

                <!-- Логин -->
                <TextBlock Text="Логин" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                    <TextBox x:Name="LoginBox"
                             Grid.Column="0"
                             Watermark="Введите логин"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             CornerRadius="10"
                             Padding="15" />
                    <Button x:Name="CopyLoginButton"
                            Grid.Column="1"
                            Classes="icon"
                            Content="&#xE8C8;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Width="40"
                            Height="36"
                            Margin="8,0,0,0"
                            CornerRadius="8"
                            FontSize="16"
                            Click="OnCopyLoginClick"
                            ToolTip.Tip="Скопировать логин" />
                </Grid>

                <!-- Пароль -->
                <TextBlock Text="Пароль" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5,0,0">
                    <TextBox x:Name="PasswordBox"
                             Grid.Column="0"
                             Watermark="Пароль"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             CornerRadius="10"
                             Padding="12,10" />
                    <Button x:Name="GeneratePasswordButton"
                            Grid.Column="1"
                            Classes="primary"
                            Content="&#xE72C;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Width="40"
                            Height="36"
                            Margin="8,0,0,0"
                            CornerRadius="8"
                            FontSize="16"
                            Click="OnGeneratePasswordClick"
                            ToolTip.Tip="Сгенерировать пароль" />
                    <Button x:Name="CopyPasswordButton"
                            Grid.Column="2"
                            Classes="icon"
                            Content="&#xE8C8;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Width="40"
                            Height="36"
                            Margin="8,0,0,0"
                            CornerRadius="8"
                            FontSize="16"
                            Click="OnCopyPasswordClick"
                            ToolTip.Tip="Скопировать пароль" />
                </Grid>

                <!-- Описание -->
                <TextBlock Text="Описание (необязательно)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" />
                <TextBox x:Name="DescriptionBox"
                         Watermark="Дополнительная информация"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         CornerRadius="10"
                         Padding="15"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="80" />

                <!-- Кнопки -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                    <Button Grid.Column="0"
                            Classes="ghost"
                            Content="Отмена"
                            Height="40"
                            CornerRadius="10"
                            Click="OnCancelClick" />
                    <Button Grid.Column="1"
                            Classes="primary"
                            Content="Сохранить"
                            Height="40"
                            CornerRadius="10"
                            Click="OnSaveClick" />
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
