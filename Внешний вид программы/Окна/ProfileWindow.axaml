<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TinaPASS.Main.ProfileWindow"
        Title="Профиль"
        Icon="/Assets/Логотип.ico"
        Width="400"
        Height="500"
        MinWidth="350"
        MinHeight="400"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Аватарка -->
        <Border Grid.Row="0"
                Width="120"
                Height="120"
                CornerRadius="60"
                Background="{DynamicResource SurfaceBrush}"
                HorizontalAlignment="Center"
                Margin="0,20,0,10"
                Cursor="Hand"
                PointerPressed="OnAvatarClick">
            <Grid>
                <Image x:Name="AvatarImage"
                       Stretch="UniformToFill" />
                <TextBlock x:Name="AvatarText"
                           Text="&#xE77B;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="50"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="Информация о профиле"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20" />

        <!-- Email -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="10"
                Padding="15"
                Margin="0,5,0,5"
                Cursor="Hand"
                PointerPressed="OnEmailCopyClick">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                    Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="&#xE715;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Email:"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="EmailText"
                           Grid.Column="1"
                           Text="-"
                           FontSize="14"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="15,0,10,0"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="2"
                           Text="&#xE8C8;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           ToolTip.Tip="Копировать email" />
            </Grid>
        </Border>

        <!-- ID пользователя -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="10"
                Padding="15"
                Margin="0,5,0,5">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0"
                    Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="ID:"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="IdText"
                           Grid.Column="1"
                           Text="-"
                           FontSize="12"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Режим синхронизации -->
        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="10"
                Padding="15"
                Margin="0,5,0,5">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0"
                    Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="&#xE753;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Режим:"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SyncModeText"
                           Grid.Column="1"
                           Text="Облачный"
                           FontSize="14"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0" />
            </Grid>
        </Border>

        <!-- Кнопка выхода -->
        <Button Grid.Row="5"
                Content="Выйти из аккаунта"
                Background="#FF4444"
                CornerRadius="10"
                Height="45"
                FontSize="14"
                FontWeight="Bold"
                Margin="0,30,0,10"
                Click="OnLogoutClick" />

        <Button Grid.Row="5"
                Content="Закрыть"
                Background="{DynamicResource PrimaryBrush}"
                CornerRadius="10"
                Height="40"
                FontSize="13"
                VerticalAlignment="Bottom"
                Click="OnCloseClick" />
    </Grid>
</Window>